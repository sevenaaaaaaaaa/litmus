{
  "manifest_version": 3,
  "name": "Litmus Clipper",
  "version": "0.3.0",
  "description": "一键采集网页到 Litmus 知识库（林下出品 · 登录页自动授权）",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://nownexts.com/*",
        "https://*.nownexts.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "48": "icon48.png"
  }
}