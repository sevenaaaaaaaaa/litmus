{
  "manifest_version": 3,
  "name": "Litmus Clipper",
  "version": "0.3.0",
  "description": "一键采集网页到鹿蕊知识库（林下出品 · 登录页自动授权）",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "scripts": [
      "bg.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "litmus@nownexts.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://nownexts.com/*",
        "https://*.nownexts.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}